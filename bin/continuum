#!/usr/bin/env python3
"""
Continuum — project launcher

Bind a repository to a project name, resume its Pi session, and keep
UTC-traceable day snapshots under .agent/.

This is intentionally conservative and dependency-free. It does not install
packages or start Pi during `new`.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
REGISTRY = HOME / ".pi" / "projects" / "registry.json"
TEMPLATE = Path(__file__).resolve().parent.parent / "templates" / "project"
DEFAULT_MODEL = "deepseek/deepseek-flash"
DEFAULT_VERIFIER = "deepseek/deepseek-flash"
REQUIRED_PACKAGES = (
    "npm:@lolipopshock/pi-clm@1.0.0",
    "npm:pi-subagents@0.79.1",
)
RESERVED_WRAPPER_NAMES = {
    "bash",
    "continuum",
    "fish",
    "git",
    "node",
    "npm",
    "npx",
    "pi",
    "pi-project",
    "pi-project.py",
    "python",
    "python3",
    "sh",
    "sudo",
    "tmux",
    "zsh",
}
EVIDENCE_FILES = (
    "TASK.md",
    "PLAN.md",
    "VERDICT.json",
    "HANDOFF.md",
    "diff.patch",
    "tests.log",
)
REQUIRED_EVIDENCE = ("TASK.md", "PLAN.md")
MERGE_TEMPLATE_FILES = {Path(".gitignore"), Path(".pi/settings.json")}


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def utc_day() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


def safe_name(name: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-._")
    if not cleaned:
        raise SystemExit("project name must contain at least one letter or number")
    if not cleaned[0].isalnum():
        cleaned = f"p-{cleaned}"
    return cleaned


def load_registry() -> dict:
    try:
        return json.loads(REGISTRY.read_text())
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid registry {REGISTRY}: {exc}") from exc


@contextmanager
def registry_lock():
    REGISTRY.parent.mkdir(parents=True, exist_ok=True)
    lock_path = REGISTRY.with_name("registry.lock")
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def save_registry(registry: dict, require_absent: bool = False) -> None:
    """Merge entries while holding the registry lock.

    A read/modify/write race here can silently lose a project created by a
    concurrent `continuum new`, so the merge happens under the lock rather
    than trusting the caller's earlier snapshot.
    """
    with registry_lock():
        current = load_registry()
        if require_absent:
            duplicates = sorted(set(registry) & set(current))
            if duplicates:
                raise SystemExit(
                    f"project already exists: {', '.join(duplicates)} "
                    "(created by a concurrent command)"
                )
        current.update(registry)
        tmp = REGISTRY.with_suffix(f".tmp-{os.getpid()}")
        tmp.write_text(json.dumps(current, indent=2) + "\n")
        tmp.replace(REGISTRY)


def project_dir(name: str) -> Path:
    entry = load_registry().get(name)
    if not entry:
        raise SystemExit(f"unknown project: {name}")
    return Path(entry["repo"]).expanduser().resolve()


def read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid JSON {path}: {exc}") from exc


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(f"{path.suffix}.tmp-{os.getpid()}")
    tmp.write_text(text)
    tmp.replace(path)


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


class JsonlIntegrityError(ValueError):
    """A JSONL file is corrupt before its final line."""


def read_complete_jsonl(path: Path) -> str:
    """Return complete records, rejecting corruption before the tail.

    A partial final line is a normal crash artifact and is dropped. A bad line
    with valid-looking data after it is corruption; silently truncating there
    would lose history while still producing a "valid" archive.
    """
    try:
        raw = path.read_bytes().decode("utf-8")
    except UnicodeDecodeError as exc:
        raise JsonlIntegrityError(
            f"invalid UTF-8 at byte {exc.start}: {exc.reason}"
        ) from exc
    # Split only on LF. str.splitlines() also splits on U+2028/U+2029 and
    # other Unicode separators that can legally appear inside JSON strings.
    lines = raw.split("\n")
    kept: list[str] = []
    for index, line in enumerate(lines):
        candidate = line[:-1] if line.endswith("\r") else line
        if not candidate.strip():
            continue
        try:
            json.loads(candidate)
        except json.JSONDecodeError as exc:
            later = "\n".join(lines[index + 1 :]).strip()
            if later:
                raise JsonlIntegrityError(
                    f"malformed JSONL at line {index + 1}: {exc.msg}"
                ) from exc
            break
        kept.append(candidate)
    return "\n".join(kept) + "\n"


def jsonl_stats(text: str) -> tuple[int, str | None]:
    rows = [line for line in text.split("\n") if line.strip()]
    last_id: str | None = None
    for line in reversed(rows):
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(row, dict) and isinstance(row.get("id"), str):
            last_id = row["id"]
            break
    return len(rows), last_id


def archive_inventory(day_dir: Path) -> dict[str, dict]:
    files: dict[str, dict] = {}
    for path in sorted(day_dir.rglob("*")):
        if not path.is_file() or path.name in {"manifest.json", "seal.json"}:
            continue
        relative = path.relative_to(day_dir).as_posix()
        files[relative] = {
            "sha256": sha256_file(path),
            "bytes": path.stat().st_size,
        }
    return files


def append_ledger(root: Path, event: str, **fields) -> None:
    path = root / ".agent" / "ledger.ndjson"
    path.parent.mkdir(parents=True, exist_ok=True)
    row = {"ts": utc_now(), "event": event, **fields}
    with path.open("a") as handle:
        handle.write(json.dumps(row) + "\n")


def backup_path(root: Path, relative: Path, stamp: str | None = None) -> Path:
    stamp = stamp or utc_now().replace(":", "").replace(".", "").replace("+", "-")
    return root / ".agent" / "backups" / f"new-{stamp}" / relative


def copy_template(root: Path, force: bool = False) -> None:
    if not TEMPLATE.exists():
        raise SystemExit(f"template not found: {TEMPLATE}")
    stamp = utc_now().replace(":", "").replace(".", "").replace("+", "-")
    for source in TEMPLATE.rglob("*"):
        if not source.is_file():
            continue
        relative = source.relative_to(TEMPLATE)
        destination = root / relative
        if destination.exists() and (not force or relative in MERGE_TEMPLATE_FILES):
            continue
        if destination.exists() and force:
            backup = backup_path(root, relative, stamp)
            backup.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(destination, backup)
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
    sample = root / ".agent" / "project.example.json"
    if sample.exists():
        sample.unlink()


def copy_subagent_state(root: Path, session_file: Path, session_id: str, day_dir: Path) -> None:
    """Copy the current session's child runs and subagent artifacts into the day archive."""
    session_root = session_dir(root)

    # pi-subagents stores child run directories under <sessionDir>/<parent-session-stem>/.
    child_dir = session_root / session_file.stem
    if child_dir.is_dir():
        shutil.copytree(child_dir, day_dir / "subagent-sessions", dirs_exist_ok=True)

    # It also writes per-run artifacts under <sessionDir>/subagent-artifacts/.
    artifacts = session_root / "subagent-artifacts"
    if artifacts.is_dir():
        dest = day_dir / "subagent-artifacts"
        dest.mkdir(parents=True, exist_ok=True)
        for meta in artifacts.glob("*_meta.json"):
            try:
                data = json.loads(meta.read_text())
            except (OSError, json.JSONDecodeError):
                continue
            if data.get("parentSessionId") != session_id:
                continue
            run_id = data.get("runId")
            if not run_id:
                continue
            for source in artifacts.glob(f"{run_id}_*"):
                if source.is_file():
                    shutil.copy2(source, dest / source.name)

    # pi-interactive-subagents-style artifacts, when present.
    interactive_dir = session_root / "artifacts" / session_id
    if interactive_dir.is_dir():
        shutil.copytree(interactive_dir, day_dir / "artifacts", dirs_exist_ok=True)


def pi_package_listing(cwd: Path | None = None) -> str | None:
    if shutil.which(pi_binary()) is None:
        return None
    try:
        result = subprocess.run(
            [pi_binary(), "list"],
            capture_output=True,
            text=True,
            timeout=5,
            cwd=cwd,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout if result.returncode == 0 else None


def continuum_package_installed() -> bool:
    agent_dir = Path(os.environ.get("PI_CODING_AGENT_DIR", HOME / ".pi" / "agent"))
    candidates = [
        agent_dir / "npm" / "node_modules" / "pi-continuum",
        HOME / ".pi" / "agent" / "npm" / "node_modules" / "pi-continuum",
    ]
    if any(path.exists() for path in candidates):
        return True
    # Git-installed Pi packages do not necessarily live under npm/node_modules.
    # `pi list` is the authoritative installed-package view when Pi is present.
    listing = pi_package_listing()
    return bool(listing and "pi-continuum" in listing)


def copy_runtime_extension(root: Path, force: bool = False) -> None:
    """Install the packaged Continuum extension into a project."""
    package_root = Path(__file__).resolve().parent.parent
    source = package_root / "extensions" / "continuum.ts"
    destination = root / ".pi" / "extensions" / "continuum.ts"
    if not source.exists():
        raise SystemExit(f"packaged extension missing: {source}")
    if destination.exists() and not force:
        return
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, destination)


def wrapper_dir() -> Path:
    """Prefer a user bin directory that is already on PATH."""
    path_dirs = {Path(item).expanduser().resolve() for item in os.environ.get("PATH", "").split(os.pathsep) if item}
    candidates = [HOME / ".local" / "bin", HOME / ".pi" / "agent" / "bin"]
    for candidate in candidates:
        if candidate.resolve() in path_dirs:
            return candidate
    return candidates[0]


def package_identity(spec: str) -> str:
    value = spec.strip()
    if value.startswith("npm:"):
        value = value[4:]
    slash = value.find("/")
    at = value.find("@", slash + 1 if slash >= 0 else 1)
    return value[:at] if at > 0 else value


def merge_settings(path: Path, verifier_model: str, override_verifier: bool = False) -> None:
    """Add Continuum requirements without discarding existing Pi settings."""
    settings = read_json(path, {}) or {}
    if not isinstance(settings, dict):
        raise SystemExit(f"invalid settings (expected object): {path}")

    settings.setdefault("sessionDir", ".agent/sessions")
    packages = settings.setdefault("packages", [])
    if not isinstance(packages, list):
        raise SystemExit(f"invalid packages list in {path}")
    identities = {package_identity(str(item)) for item in packages}
    for required in REQUIRED_PACKAGES:
        identity = package_identity(required)
        if identity not in identities:
            packages.append(required)
            identities.add(identity)

    subagents = settings.setdefault("subagents", {})
    if not isinstance(subagents, dict):
        raise SystemExit(f"invalid subagents object in {path}")
    subagents.setdefault("defaultModel", DEFAULT_MODEL)
    subagents.setdefault("defaultThinking", "high")
    # Core agents also declare this explicitly. Keeping the project default
    # prevents a future agent from silently loading pi-clm/continuum again.
    subagents.setdefault("defaultExtensions", [])
    overrides = subagents.setdefault("agentOverrides", {})
    if not isinstance(overrides, dict):
        raise SystemExit(f"invalid subagents.agentOverrides object in {path}")
    verifier = overrides.setdefault("verifier", {})
    if not isinstance(verifier, dict):
        raise SystemExit(f"invalid verifier override in {path}")
    # Preserve an existing explicit override when re-running `new` on an
    # existing repository. A fresh project has no override and gets the CLI
    # value (or the default).
    if override_verifier:
        verifier["model"] = verifier_model
    else:
        verifier.setdefault("model", verifier_model)

    write_atomic(path, json.dumps(settings, indent=2) + "\n")


def merge_gitignore(root: Path) -> None:
    path = root / ".gitignore"
    existing = path.read_text() if path.exists() else ""
    required = [".agent/*", "!.agent/.gitignore", "*.jsonl", "auth.json", ".env", ".env.*"]
    if all(item in existing.splitlines() for item in required):
        return
    block = (
        "# BEGIN continuum runtime\n"
        + "\n".join(required)
        + "\n# END continuum runtime\n"
    )
    prefix = existing
    if prefix and not prefix.endswith("\n"):
        prefix += "\n"
    if prefix:
        prefix += "\n"
    write_atomic(path, prefix + block)


def ensure_agent_gitignore(root: Path) -> None:
    path = root / ".agent" / ".gitignore"
    if not path.exists():
        write_atomic(path, "*\n!.gitignore\n")


def acquire_writer_lock(root: Path) -> int:
    """Hold an exclusive project writer lock for the lifetime of the process."""
    path = root / ".agent" / "locks" / "open.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        os.close(fd)
        raise SystemExit(
            f"project is already open: {root} (open.lock is held by another writer)"
        ) from exc
    os.set_inheritable(fd, True)
    os.ftruncate(fd, 0)
    os.write(fd, f"{os.getpid()}\n".encode())
    return fd


@contextmanager
def exclusive_project_lock(root: Path):
    path = root / ".agent" / "locks" / "open.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise SystemExit(
                f"project is open: {root} (close the writer before this operation)"
            ) from exc
        yield
    finally:
        os.close(fd)


@contextmanager
def shared_project_lock(root: Path):
    path = root / ".agent" / "locks" / "open.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise SystemExit(
                f"project is open: {root} (close the writer before this operation)"
            ) from exc
        yield
    finally:
        os.close(fd)


def cmd_internal_run(args: argparse.Namespace) -> int:
    """Acquire the writer lock, then exec a command inside a tmux pane."""
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        raise SystemExit("_run requires a command")
    root = Path(args.root).expanduser().resolve()
    acquire_writer_lock(root)
    os.chdir(root)
    sys.stdout.flush()
    sys.stderr.flush()
    os.execvpe(command[0], command, os.environ.copy())
    return 0


def cmd_new(args: argparse.Namespace) -> int:
    name = safe_name(args.name)
    registry = load_registry()
    if name in registry and not args.force:
        raise SystemExit(f"project already exists: {name} (use --force to overwrite metadata)")
    if not args.no_link and name in RESERVED_WRAPPER_NAMES:
        raise SystemExit(
            f"project name '{name}' is reserved; it would shadow a command on PATH. "
            "Use --no-link or choose another name."
        )

    repo = Path(args.repo).expanduser().resolve()
    if not repo.exists():
        raise SystemExit(f"repository does not exist: {repo}")
    if not repo.is_dir():
        raise SystemExit(f"not a directory: {repo}")

    for other_name, entry in registry.items():
        if other_name == name:
            continue
        other_repo = Path(entry.get("repo", "")).expanduser()
        try:
            same_repo = other_repo.resolve() == repo
        except OSError:
            same_repo = False
        if same_repo and not args.force:
            raise SystemExit(
                f"repository is already registered as '{other_name}': {repo} "
                "(use --force to register a second name)"
            )

    if not args.no_link:
        existing_cmd = shutil.which(name)
        target = Path(__file__).resolve()
        if existing_cmd and Path(existing_cmd).resolve() != target:
            raise SystemExit(
                f"'{name}' already resolves to {existing_cmd}; refusing to shadow it. "
                "Use --no-link or choose another name."
            )

    settings_path = repo / ".pi" / "settings.json"
    settings_existed = settings_path.exists()
    (repo / ".agent" / "sessions" / "days").mkdir(parents=True, exist_ok=True)
    (repo / ".agent" / "artifacts").mkdir(parents=True, exist_ok=True)
    (repo / ".agent" / "locks").mkdir(parents=True, exist_ok=True)
    copy_template(repo, force=args.force)
    merge_gitignore(repo)
    ensure_agent_gitignore(repo)
    merge_settings(
        settings_path,
        args.verifier_model,
        override_verifier=not settings_existed,
    )
    if args.local_extension or (not args.no_local_extension and not continuum_package_installed()):
        copy_runtime_extension(repo, force=args.force)

    project = {
        "name": name,
        "repo": str(repo),
        "created_at": utc_now(),
        "timezone": "UTC",
        "model": args.model,
        "thinking": args.thinking,
        "verifier_model": args.verifier_model,
        "clm": {
            "budget": 262144,
            "reserve": 32768,
            "cap": "10000:0.5",
            "trailer": True,
            "one_tool": False,
        },
        "rollover": {
            "mode": args.rollover,
            "fallback": "snapshot",
            "at": "00:00Z",
        },
        "tmux": {"session": f"pi-{name}"},
        "backup": {"mode": "none"},
    }
    write_atomic(repo / ".agent" / "project.json", json.dumps(project, indent=2) + "\n")

    save_registry(
        {name: {"repo": str(repo), "created_at": project["created_at"]}},
        require_absent=name not in registry,
    )

    linked = False
    link: Path | None = None
    if not args.no_link:
        bin_dir = wrapper_dir()
        bin_dir.mkdir(parents=True, exist_ok=True)
        link = bin_dir / name
        target = Path(__file__).resolve()
        if link.exists() or link.is_symlink():
            if link.is_symlink() and link.resolve() == target:
                linked = True
            elif args.force:
                if link.is_symlink() or link.is_file():
                    backup = backup_path(repo, Path("wrapper") / name)
                    backup.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(link, backup)
                link.unlink()
                link.symlink_to(target)
                linked = True
            else:
                raise SystemExit(
                    f"wrapper already exists and is not Continuum: {link} "
                    "(use --force to replace it or --no-link)"
                )
        else:
            link.symlink_to(target)
            linked = True

    print(f"created project {name}")
    print(f"  repo:    {repo}")
    print(f"  state:   {repo / '.agent'}")
    print(f"  config:  {repo / '.pi'}")
    print(f"  wrapper: {link if linked else '(not linked)'}")
    print()
    print("Next: review .pi/settings.json, then run:")
    if linked and link:
        path_dirs = {Path(item).expanduser().resolve() for item in os.environ.get("PATH", "").split(os.pathsep) if item}
        if link.parent.resolve() not in path_dirs:
            print(f"  warning: {link.parent} is not on PATH; add it to use `{name}` directly")
    print(f"  {name}" if linked else f"  continuum open {name}")
    return 0


def tmux_available() -> bool:
    return shutil.which("tmux") is not None


def tmux_has(session: str) -> bool:
    if not tmux_available():
        return False
    return subprocess.run(
        ["tmux", "has-session", "-t", session],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


def attach_tmux(session: str) -> None:
    if os.environ.get("TMUX"):
        result = subprocess.run(["tmux", "switch-client", "-t", session])
        if result.returncode != 0:
            print(f"tmux session {session} is running; attach with: tmux attach -t {session}")
        return
    os.execvp("tmux", ["tmux", "attach-session", "-t", session])


def active_session(root: Path) -> dict | None:
    return read_json(root / ".agent" / "active.json", None)


def active_session_file(root: Path, active: dict) -> Path:
    """Resolve Pi's session path against the project root.

    Pi may report a project-relative path (for example
    `.agent/sessions/<file>.jsonl`) while the launcher is invoked from any
    directory. Treating that path as relative to the caller's cwd makes
    resume, seal, and fork fail even though the session exists.
    """
    raw = active.get("session_file")
    if not isinstance(raw, str) or not raw:
        return root / ".agent" / "sessions" / "__missing__"
    path = Path(raw).expanduser()
    return path if path.is_absolute() else root / path


def session_dir(root: Path) -> Path:
    return root / ".agent" / "sessions"


def pi_binary() -> str:
    return os.environ.get("PI_BIN", "pi")


def clm_env(root: Path, project: dict) -> dict:
    clm = project.get("clm", {})
    env = os.environ.copy()
    env["PI_CLM_BUDGET"] = str(clm.get("budget", 262144))
    env["PI_CLM_RESERVE"] = str(clm.get("reserve", 32768))
    env["PI_CLM_OBSERVATION_CAP"] = str(clm.get("cap", "10000:0.5"))
    if clm.get("trailer", True):
        env["PI_CLM_SIZE_TRAILER"] = "1"
    if clm.get("one_tool", False):
        env["PI_CLM_ONE_TOOL_PER_TURN"] = "1"
    env["PI_CLM_STEERING"] = str(root / "CLM_STEERING.md")
    env["PI_PROJECT_NAME"] = project["name"]
    env["PI_PROJECT_ROOT"] = str(root)
    return env


def effective_verifier_model(root: Path, project: dict) -> str:
    settings = read_json(root / ".pi" / "settings.json", {}) or {}
    subagents = settings.get("subagents") if isinstance(settings, dict) else None
    overrides = subagents.get("agentOverrides") if isinstance(subagents, dict) else None
    verifier = overrides.get("verifier") if isinstance(overrides, dict) else None
    model = verifier.get("model") if isinstance(verifier, dict) else None
    if isinstance(model, str) and model:
        return model
    configured = project.get("verifier_model", DEFAULT_VERIFIER)
    return configured if isinstance(configured, str) and configured else DEFAULT_VERIFIER


def launch_command(
    root: Path,
    project: dict,
    session_id: str,
    fork_from: Path | None = None,
) -> list[str]:
    cmd = [
        pi_binary(),
        "--session-id",
        session_id,
        "--session-dir",
        str(session_dir(root)),
        "--name",
        f"{project['name']} {utc_day()}",
        "--model",
        project.get("model", DEFAULT_MODEL),
        "--thinking",
        project.get("thinking", "high"),
    ]
    if fork_from is not None:
        cmd[1:1] = ["--fork", str(fork_from)]
    return cmd


def start_in_tmux(root: Path, project: dict, cmd: list[str]) -> None:
    session = project.get("tmux", {}).get("session", f"pi-{project['name']}")
    env = clm_env(root, project)
    # The pane process, not the short-lived tmux client, must hold the writer
    # lock. A tiny internal launcher acquires it and then execs Pi.
    locked_cmd = [
        sys.executable,
        str(Path(__file__).resolve()),
        "_run",
        str(root),
        "--",
        *cmd,
    ]
    command = " ".join(shlex.quote(part) for part in locked_cmd)

    # Creating a session from inside tmux is rejected unless $TMUX is removed
    # from the child environment. Create it detached, then switch this client.
    if os.environ.get("TMUX"):
        tmux_env = env.copy()
        tmux_env.pop("TMUX", None)
        subprocess.run(
            ["tmux", "new-session", "-d", "-s", session, "-c", str(root), command],
            env=tmux_env,
            check=True,
        )
        result = subprocess.run(["tmux", "switch-client", "-t", session], env=env)
        if result.returncode != 0:
            print(f"tmux session {session} created; attach with: tmux attach -t {session}")
        return

    tmux_cmd = [
        "tmux",
        "new-session",
        "-A",
        "-s",
        session,
        "-c",
        str(root),
        command,
    ]
    sys.stdout.flush()
    sys.stderr.flush()
    os.execvpe("tmux", tmux_cmd, env)

def quick_preflight(root: Path, project: dict, require_tmux: bool = False) -> bool:
    problems = []
    if not root.exists():
        problems.append(f"repo missing: {root}")
    if not (root / ".agent" / "project.json").exists():
        problems.append(f"missing project config: {root / '.agent' / 'project.json'}")
    if require_tmux and not tmux_available():
        problems.append("tmux is not installed; interactive subagents need tmux")
    active = active_session(root)
    if active:
        session_file = active_session_file(root, active)
        if not session_file.exists():
            problems.append(f"active session file missing: {session_file}")
    if problems:
        for problem in problems:
            print(f"preflight: {problem}", file=sys.stderr)
        print("run `continuum doctor` for details", file=sys.stderr)
        return False
    return True


def cmd_doctor(args: argparse.Namespace) -> int:
    name = safe_name(args.name)
    root = project_dir(name)
    project = read_json(root / ".agent" / "project.json", None) or {}
    active = active_session(root)
    failures = 0
    warnings = 0

    def check(label: str, ok: bool, detail: str = "", required: bool = True) -> None:
        nonlocal failures, warnings
        status = "PASS" if ok else ("FAIL" if required else "WARN")
        print(f"{status:4} {label}" + (f": {detail}" if detail else ""))
        if not ok:
            if required:
                failures += 1
            else:
                warnings += 1

    check("repo exists", root.exists(), str(root))
    check("project config", (root / ".agent" / "project.json").exists(), str(root / ".agent" / "project.json"))
    check("Pi config", (root / ".pi" / "settings.json").exists(), str(root / ".pi" / "settings.json"))
    local_extension = root / ".pi" / "extensions" / "continuum.ts"
    check(
        "Continuum extension",
        local_extension.exists() or continuum_package_installed(),
        str(local_extension) if local_extension.exists() else "global pi-continuum package",
    )
    check("CLM steering", (root / "CLM_STEERING.md").exists(), str(root / "CLM_STEERING.md"))
    check("task template", (root / "TASK.md").exists(), str(root / "TASK.md"))
    check("pi binary", shutil.which(pi_binary()) is not None, pi_binary())
    check("tmux", tmux_available(), "required for interactive subagents", required=False)

    if active:
        session_file = active_session_file(root, active)
        check("active session file", session_file.exists(), str(session_file))

    # Package declarations are a stronger signal than guessing install paths.
    settings = read_json(root / ".pi" / "settings.json", {}) or {}
    if not isinstance(settings, dict):
        settings = {}
    packages = settings.get("packages", [])
    declared = "\n".join(str(item) for item in packages)
    check("pi-clm declared", "pi-clm" in declared, "npm:@lolipopshock/pi-clm")
    check("pi-subagents declared", "pi-subagents" in declared, "npm:pi-subagents")

    listing = pi_package_listing(root)
    if listing is not None:
        check("pi-clm installed", "pi-clm" in listing, "pi list", required=False)
        check("pi-subagents installed", "pi-subagents" in listing, "pi list", required=False)
    check(
        "no second compaction manager",
        "pi-observational-memory" not in declared,
        "pi-clm and pi-observational-memory must not run together",
        required=False,
    )

    # Model auth: do not print secrets; just check common sources.
    auth = read_json(HOME / ".pi" / "agent" / "auth.json", {}) or {}
    has_key = bool(os.environ.get("DEEPSEEK_API_KEY")) or "deepseek" in auth
    check("DeepSeek auth", has_key, "set DEEPSEEK_API_KEY or use /login deepseek", required=False)

    configured_verifier = project.get("verifier_model", DEFAULT_VERIFIER)
    effective_verifier = effective_verifier_model(root, project)
    check(
        "effective verifier model",
        effective_verifier == configured_verifier,
        f"{effective_verifier} (configured {configured_verifier})",
    )

    check("rollover mode", project.get("rollover", {}).get("mode") in {"snapshot", "fork"}, project.get("rollover", {}).get("mode", "missing"))
    print()
    if failures:
        print(f"{failures} required check(s) failed")
        return 1
    if warnings:
        print(f"ready with {warnings} warning(s)")
        return 0
    print("ready")
    return 0



def used_session_ids(root: Path) -> set[str]:
    """Collect session IDs from live files, active state, and archived days.

    Pi names live files with a timestamp prefix, so checking only
    ``<session-id>.jsonl`` misses collisions. Header IDs and archive directory
    names are the authoritative identifiers.
    """
    ids: set[str] = set()
    active = active_session(root)
    if active and isinstance(active.get("session_id"), str):
        ids.add(active["session_id"])

    sessions = session_dir(root)
    if sessions.is_dir():
        for path in sessions.glob("*.jsonl"):
            try:
                with path.open() as handle:
                    header = json.loads(handle.readline())
            except (OSError, json.JSONDecodeError):
                continue
            if isinstance(header, dict) and isinstance(header.get("id"), str):
                ids.add(header["id"])

        days = sessions / "days"
        if days.is_dir():
            for day_dir in days.iterdir():
                if day_dir.is_dir():
                    ids.update(item.name for item in day_dir.iterdir() if item.is_dir())
    return ids


def fresh_session_id(root: Path, name: str, day: str | None = None) -> str:
    base = f"{name}-{(day or utc_day()).replace('-', '')}"
    stamp = datetime.now(timezone.utc).strftime("%H%M%S")
    used = used_session_ids(root)
    candidate = f"{base}-{stamp}"
    counter = 1
    while candidate in used:
        candidate = f"{base}-{stamp}-{counter}"
        counter += 1
    return candidate


def cmd_open(args: argparse.Namespace) -> int:
    name = safe_name(args.name)
    root = project_dir(name)
    project = read_json(root / ".agent" / "project.json", None)
    if not project:
        raise SystemExit(f"missing {root / '.agent' / 'project.json'}")

    if not args.no_preflight and not quick_preflight(root, project):
        return 2

    session = project.get("tmux", {}).get("session", f"pi-{name}")
    use_tmux = tmux_available() and not args.no_tmux

    # Attach is an interactive action, not a dry-run action. Check it only
    # after dry-run has been ruled out, and only when tmux is actually wanted.
    if not args.dry_run and use_tmux and tmux_has(session):
        attach_tmux(session)
        return 0

    if not tmux_available():
        print("warning: tmux not found; running directly without attach/resume support", file=sys.stderr)
    elif args.no_tmux:
        print("warning: --no-tmux; running directly without attach/resume support", file=sys.stderr)

    # Hold the project writer lock for the life of a direct Pi process. The fd
    # is inheritable, so execve keeps the flock held without a supervisor.
    if not args.dry_run and not use_tmux:
        acquire_writer_lock(root)

    active = active_session(root)
    today = utc_day()
    fork_from: Path | None = None
    session_id = f"{name}-{today.replace('-', '')}"
    mode = project.get("rollover", {}).get("mode", "snapshot")

    if active:
        session_file = active_session_file(root, active)
        active_day = active.get("utc_day")
        session_id = active.get("session_id") or session_id
        if active_day and active_day != today:
            action = "would seal" if args.dry_run else "sealing"
            target = (
                root
                / ".agent"
                / "sessions"
                / "days"
                / active_day
                / session_id
            )
            print(
                f"UTC day changed: {active_day} -> {today}; "
                f"{action} {active_day} -> {target} (reason: open-rollover)"
            )
            if not args.dry_run:
                seal_project(name, quiet=True, reason="open-rollover", writer_locked=not use_tmux)
            if mode == "fork" and session_file.exists():
                fork_from = session_file
                session_id = fresh_session_id(root, name, today)
        elif session_file.exists():
            session_id = active.get("session_id") or session_id

    cmd = launch_command(root, project, session_id, fork_from=fork_from)
    print(f"opening {name} ({today})")
    print(f"  repo:    {root}")
    print(f"  session: {session_id}")
    if fork_from:
        print(f"  fork:    {fork_from}")

    if args.dry_run:
        print("dry-run command:")
        print("  " + " ".join(shlex.quote(part) for part in cmd))
        env = clm_env(root, project)
        for key in (
            "PI_CLM_BUDGET",
            "PI_CLM_RESERVE",
            "PI_CLM_OBSERVATION_CAP",
            "PI_CLM_SIZE_TRAILER",
            "PI_CLM_STEERING",
        ):
            print(f"  {key}={env.get(key)}")
        return 0

    if not use_tmux:
        env = clm_env(root, project)
        os.chdir(root)
        sys.stdout.flush()
        sys.stderr.flush()
        os.execvpe(cmd[0], cmd, env)
        return 0

    start_in_tmux(root, project, cmd)
    return 0


def seal_project(
    name: str,
    quiet: bool = False,
    reason: str = "manual-seal",
    writer_locked: bool = False,
) -> int:
    root = project_dir(name)
    if not writer_locked:
        with exclusive_project_lock(root):
            return seal_project(name, quiet=quiet, reason=reason, writer_locked=True)
    project = read_json(root / ".agent" / "project.json", None)
    if not project:
        raise SystemExit(f"missing project config for {name}")
    active = active_session(root)
    if not active:
        if not quiet:
            print("no active session to seal")
        return 0

    day = active.get("utc_day") or utc_day()
    session_id = active.get("session_id") or "unknown"
    day_dir = root / ".agent" / "sessions" / "days" / day / session_id
    day_dir.mkdir(parents=True, exist_ok=True)

    lock_path = root / ".agent" / "locks" / "seal.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        session_file = active_session_file(root, active)
        if not session_file.exists():
            raise SystemExit(f"session file missing: {session_file}")

        try:
            complete = read_complete_jsonl(session_file)
        except JsonlIntegrityError as exc:
            raise SystemExit(f"cannot seal {name}: {exc}") from exc
        rows = [line for line in complete.split("\n") if line.strip()]
        if not rows:
            raise SystemExit(f"cannot seal {name}: session has no complete JSONL records")
        try:
            header = json.loads(rows[0])
        except json.JSONDecodeError as exc:
            raise SystemExit(f"cannot seal {name}: invalid session header: {exc.msg}") from exc
        if (
            not isinstance(header, dict)
            or header.get("type") != "session"
            or not isinstance(header.get("id"), str)
        ):
            raise SystemExit(f"cannot seal {name}: first JSONL record is not a session header")
        if header["id"] != session_id:
            raise SystemExit(
                f"cannot seal {name}: active session id {session_id!r} "
                f"does not match header id {header['id']!r}"
            )
        snapshot_file = day_dir / "session.jsonl"
        write_atomic(snapshot_file, complete)
        digest = hashlib.sha256(complete.encode()).hexdigest()
        entry_count, last_entry_id = jsonl_stats(complete)

        copy_subagent_state(root, session_file, session_id, day_dir)

        for name_file in EVIDENCE_FILES:
            source = root / name_file
            destination = day_dir / name_file
            if source.exists():
                shutil.copy2(source, destination)
            elif destination.exists():
                destination.unlink()
        missing_evidence = [name_file for name_file in REQUIRED_EVIDENCE if not (root / name_file).exists()]

        previous_seal = None
        seal_path = day_dir / "seal.json"
        if seal_path.exists():
            try:
                previous_seal = json.loads(seal_path.read_text()).get("seal")
            except (OSError, json.JSONDecodeError):
                previous_seal = None

        manifest = {
            "project": name,
            "day": day,
            "session_id": session_id,
            "session_file": str(session_file),
            "leaf_id": active.get("leaf_id"),
            "snapshot_at": utc_now(),
            "reason": reason,
            "model": active.get("model"),
            "source_bytes": session_file.stat().st_size,
            "bytes": snapshot_file.stat().st_size,
            "sha256": digest,
            "entry_count": entry_count,
            "last_entry_id": last_entry_id,
            "missing_evidence": missing_evidence,
            "files": archive_inventory(day_dir),
        }
        write_atomic(day_dir / "manifest.json", json.dumps(manifest, indent=2) + "\n")
        seal = {
            **manifest,
            "previous_seal": previous_seal,
            "seal": hashlib.sha256(
                f"{previous_seal or ''}\n{digest}\n{manifest['snapshot_at']}".encode()
            ).hexdigest(),
        }
        write_atomic(seal_path, json.dumps(seal, indent=2) + "\n")
        append_ledger(root, "day_seal", day=day, session_id=session_id, reason=reason, sha256=digest)

    if not quiet:
        print(f"sealed {name} / {day}")
        print(f"  snapshot: {day_dir / 'session.jsonl'}")
        print(f"  sha256:   {digest}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    name = safe_name(args.name)
    root = project_dir(name)
    project = read_json(root / ".agent" / "project.json", None) or {}
    active = active_session(root)
    session = project.get("tmux", {}).get("session", f"pi-{name}")
    ledger_path = root / ".agent" / "ledger.ndjson"
    last_event = None
    if ledger_path.exists():
        lines = ledger_path.read_text().splitlines()
        if lines:
            try:
                last_event = json.loads(lines[-1])
            except json.JSONDecodeError:
                last_event = None

    print(f"project:  {name}")
    print(f"repo:     {root}")
    print(f"model:    {project.get('model', DEFAULT_MODEL)}")
    print(f"verifier: {effective_verifier_model(root, project)} (effective)")
    print(f"rollover: {project.get('rollover', {}).get('mode', 'snapshot')}")
    print(f"tmux:     {'running' if tmux_has(session) else 'stopped'} ({session})")
    print(f"utc day:  {utc_day()}")
    if active:
        print(f"active:   {active.get('utc_day')} / {active.get('session_id')}")
        print(f"session:  {active_session_file(root, active)}")
    else:
        print("active:   (none)")
    if last_event:
        print(f"last:     {last_event.get('ts')} {last_event.get('event')}")
    return 0


def cmd_list(_args: argparse.Namespace) -> int:
    registry = load_registry()
    if not registry:
        print("no projects")
        return 0
    for name, entry in sorted(registry.items()):
        print(f"{name}\t{entry.get('repo')}")
    return 0


def cmd_path(args: argparse.Namespace) -> int:
    print(project_dir(safe_name(args.name)))
    return 0


def cmd_backup(args: argparse.Namespace) -> int:
    name = safe_name(args.name)
    root = project_dir(name)
    project = read_json(root / ".agent" / "project.json", None) or {}
    backup = project.get("backup", {}) or {}
    command = args.command or backup.get("command")
    if not command:
        print("backup is not configured.")
        print("Set .agent/project.json backup.command, for example:")
        print('  "backup": {"mode": "command", "command": "restic backup \"$CONTINUUM_STATE\""}')
        print("Then run: continuum backup <name>")
        return 2
    env = os.environ.copy()
    env["CONTINUUM_PROJECT"] = name
    env["CONTINUUM_REPO"] = str(root)
    env["CONTINUUM_STATE"] = str(root / ".agent")
    print(f"backing up {name}")
    with shared_project_lock(root):
        result = subprocess.run(command, shell=True, cwd=root, env=env)
        append_ledger(root, "backup", command=command, exit_code=result.returncode)
    if result.returncode != 0:
        print(f"backup failed with exit code {result.returncode}", file=sys.stderr)
    return result.returncode


def _cmd_verify(args: argparse.Namespace) -> int:
    name = safe_name(args.name)
    root = Path(args.root).expanduser().resolve() if getattr(args, "root", None) else project_dir(name)
    if not root.exists():
        print(f"FAIL: project root does not exist: {root}")
        return 1
    days = root / ".agent" / "sessions" / "days"
    allow_empty = bool(getattr(args, "allow_empty", False))

    archive_dirs: list[Path] = []
    if days.exists():
        for day_dir in sorted(days.iterdir()):
            if not day_dir.is_dir():
                continue
            for archive in sorted(day_dir.iterdir()):
                if archive.is_dir():
                    archive_dirs.append(archive)

    ledger_path = root / ".agent" / "ledger.ndjson"
    expected: set[tuple[str, str]] = set()
    failures = 0
    if ledger_path.exists():
        for lineno, line in enumerate(ledger_path.read_text().splitlines(), 1):
            if not line.strip():
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                print(f"FAIL ledger.ndjson:{lineno}: malformed JSON")
                failures += 1
                continue
            if not isinstance(event, dict):
                print(f"FAIL ledger.ndjson:{lineno}: expected object")
                failures += 1
                continue
            if event.get("event") == "day_seal":
                day = event.get("day")
                session_id = event.get("session_id")
                if isinstance(day, str) and isinstance(session_id, str):
                    expected.add((day, session_id))
    elif archive_dirs:
        print("FAIL: ledger.ndjson is missing; cannot verify archive provenance")
        failures += 1

    if not days.exists() or not archive_dirs:
        if allow_empty and not expected and failures == 0:
            print("PASS: no day archives (allowed empty)")
            return 0
        print("FAIL: no day archives found")
        return 1

    verified = 0
    for archive in archive_dirs:
        day = archive.parent.name
        session_id = archive.name
        errors: list[str] = []
        manifest_path = archive / "manifest.json"
        seal_path = archive / "seal.json"
        session_path = archive / "session.jsonl"

        if not manifest_path.exists():
            errors.append("missing manifest.json")
        if not seal_path.exists():
            errors.append("missing seal.json")
        if not session_path.exists():
            errors.append("missing session.jsonl")
        if errors:
            for error in errors:
                print(f"FAIL {day}/{session_id}: {error}")
            failures += 1
            continue

        try:
            manifest = json.loads(manifest_path.read_text())
            seal = json.loads(seal_path.read_text())
        except json.JSONDecodeError as exc:
            print(f"FAIL {day}/{session_id}: invalid JSON: {exc}")
            failures += 1
            continue
        if not isinstance(manifest, dict) or not isinstance(seal, dict):
            print(f"FAIL {day}/{session_id}: manifest and seal must be objects")
            failures += 1
            continue

        if manifest.get("project") != name:
            errors.append(f"project {manifest.get('project')!r} != {name!r}")
        if manifest.get("day") != day:
            errors.append(f"day {manifest.get('day')!r} != {day!r}")
        if manifest.get("session_id") != session_id:
            errors.append(f"session_id {manifest.get('session_id')!r} != {session_id!r}")
        if manifest.get("bytes") != session_path.stat().st_size:
            errors.append("manifest bytes do not match session.jsonl")
        digest = sha256_file(session_path)
        if manifest.get("sha256") != digest:
            errors.append("session hash mismatch")
        if seal.get("sha256") != digest or seal.get("snapshot_at") != manifest.get("snapshot_at"):
            errors.append("seal does not match manifest")
        expected_seal = hashlib.sha256(
            f"{seal.get('previous_seal') or ''}\n{digest}\n{manifest.get('snapshot_at')}".encode()
        ).hexdigest()
        if seal.get("seal") != expected_seal:
            errors.append("seal hash mismatch")

        missing = manifest.get("missing_evidence")
        if not isinstance(missing, list):
            errors.append("manifest missing_evidence list")
        elif missing:
            errors.append(f"missing required evidence: {', '.join(str(item) for item in missing)}")

        files = manifest.get("files")
        if not isinstance(files, dict) or not files:
            errors.append("manifest file inventory is missing")
        else:
            if "session.jsonl" not in files:
                errors.append("manifest inventory does not include session.jsonl")
            archive_root = archive.resolve()
            for relative, expected_file in files.items():
                if not isinstance(relative, str) or not isinstance(expected_file, dict):
                    errors.append("invalid file inventory entry")
                    continue
                target = (archive / relative).resolve()
                try:
                    target.relative_to(archive_root)
                except ValueError:
                    errors.append(f"inventory path escapes archive: {relative}")
                    continue
                if not target.is_file():
                    errors.append(f"missing archived file: {relative}")
                    continue
                if target.stat().st_size != expected_file.get("bytes"):
                    errors.append(f"size mismatch: {relative}")
                if sha256_file(target) != expected_file.get("sha256"):
                    errors.append(f"hash mismatch: {relative}")
            actual_files = {
                path.relative_to(archive).as_posix()
                for path in archive.rglob("*")
                if path.is_file() and path.name not in {"manifest.json", "seal.json"}
            }
            unlisted = sorted(actual_files - set(files))
            if unlisted:
                errors.append(f"unlisted archived file(s): {', '.join(unlisted)}")

        try:
            header = json.loads(session_path.read_text().splitlines()[0])
        except (IndexError, json.JSONDecodeError):
            header = {}
        if header.get("id") != session_id:
            errors.append("session header id does not match archive path")

        lines = [line for line in session_path.read_text().splitlines() if line.strip()]
        if manifest.get("entry_count") != len(lines):
            errors.append("entry_count mismatch")
        last_id = None
        for line in reversed(lines):
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(row, dict) and isinstance(row.get("id"), str):
                last_id = row["id"]
                break
        if last_id != manifest.get("last_entry_id"):
            errors.append("last_entry_id mismatch")
        leaf_id = manifest.get("leaf_id")
        if leaf_id:
            ids = set()
            for line in lines:
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if isinstance(row, dict) and isinstance(row.get("id"), str):
                    ids.add(row["id"])
            if leaf_id not in ids:
                errors.append("leaf_id not present in snapshot")

        if (day, session_id) not in expected:
            errors.append("no day_seal event in ledger.ndjson")

        if errors:
            for error in errors:
                print(f"FAIL {day}/{session_id}: {error}")
            failures += 1
            continue

        verified += 1
        print(f"PASS {day}/{session_id}: {digest[:12]}…")

    for day, session_id in sorted(expected):
        if not (days / day / session_id).is_dir():
            print(f"FAIL {day}/{session_id}: archive recorded in ledger is missing")
            failures += 1

    if failures:
        print(f"{failures} verification failure(s)")
        return 1
    print(f"PASS: {verified} archive(s) verified")
    return 0


def cmd_verify(args: argparse.Namespace) -> int:
    """Verify a project while preventing a direct writer from changing state."""
    if getattr(args, "root", None):
        return _cmd_verify(args)
    name = safe_name(args.name)
    root = project_dir(name)
    with shared_project_lock(root):
        return _cmd_verify(
            argparse.Namespace(
                name=name,
                root=str(root),
                allow_empty=getattr(args, "allow_empty", False),
            )
        )


def cmd_check(args: argparse.Namespace) -> int:
    """Deterministic completion gate for TASK.md + VERDICT.json."""
    name = safe_name(args.name)
    root = project_dir(name)
    task_path = root / "TASK.md"
    verdict_path = root / "VERDICT.json"
    problems: list[str] = []

    if not task_path.exists():
        problems.append("TASK.md is missing")
    if not verdict_path.exists():
        problems.append("VERDICT.json is missing")
    if problems:
        for problem in problems:
            print(f"FAIL: {problem}")
        return 1

    try:
        verdict = json.loads(verdict_path.read_text())
    except json.JSONDecodeError as exc:
        print(f"FAIL: invalid VERDICT.json: {exc}")
        return 1
    if not isinstance(verdict, dict):
        print("FAIL: VERDICT.json must be an object")
        return 1
    if verdict.get("status") != "PASS":
        print(f"FAIL: overall verdict is {verdict.get('status')!r}, not 'PASS'")
        return 1

    checks = verdict.get("checks")
    if not isinstance(checks, list) or not checks:
        print("FAIL: VERDICT.json must contain a non-empty 'checks' list")
        return 1

    task_ids = set(
        re.findall(r"^- \[[ xX]\]\s*(AC-[A-Za-z0-9_.-]+)", task_path.read_text(), re.MULTILINE)
    )
    if not task_ids:
        print("FAIL: TASK.md has no AC-* acceptance checks")
        return 1
    seen_ids: set[str] = set()
    for index, item in enumerate(checks, 1):
        if not isinstance(item, dict):
            print(f"FAIL: checks[{index}] must be an object")
            return 1
        check_id = item.get("id")
        if not isinstance(check_id, str) or not check_id:
            print(f"FAIL: checks[{index}] is missing a string 'id'")
            return 1
        seen_ids.add(check_id)
        if item.get("status") != "PASS":
            print(f"FAIL: {check_id} is {item.get('status')!r}, not 'PASS'")
            return 1
        evidence = item.get("evidence")
        if not evidence:
            print(f"FAIL: {check_id} has no evidence")
            return 1
        if not isinstance(evidence, (str, list, dict)):
            print(f"FAIL: {check_id} evidence must be text or structured evidence")
            return 1

    missing_ids = sorted(task_ids - seen_ids)
    if missing_ids:
        print(f"FAIL: TASK.md acceptance checks lack verdict evidence: {', '.join(missing_ids)}")
        return 1

    append_ledger(root, "done_gate", verdict=str(verdict_path), checks=sorted(seen_ids))
    print(f"PASS: {len(seen_ids)} acceptance check(s) have evidence and PASS verdict")
    return 0


def cmd_fork_day(args: argparse.Namespace) -> int:
    name = safe_name(args.name)
    root = project_dir(name)
    project = read_json(root / ".agent" / "project.json", None)
    if not project:
        raise SystemExit(f"missing project config for {name}")
    if not args.no_preflight and not quick_preflight(root, project):
        return 2
    session = project.get("tmux", {}).get("session", f"pi-{name}")
    if tmux_has(session):
        raise SystemExit(f"{session} is running; exit it before forking the day")

    use_tmux = tmux_available() and not args.no_tmux
    if not args.dry_run and not use_tmux:
        acquire_writer_lock(root)
    if not args.dry_run:
        seal_project(name, quiet=True, reason="fork-day", writer_locked=not use_tmux)
    active = active_session(root)
    if not active:
        print("no active session; nothing to fork")
        return 0
    old = active_session_file(root, active)
    new_id = fresh_session_id(root, name)
    cmd = launch_command(root, project, new_id, fork_from=old if old.exists() else None)
    print(f"forking {name} -> {new_id}")
    if args.dry_run:
        print("dry-run: no seal, no session created")
        print("dry-run command:")
        print("  " + " ".join(shlex.quote(part) for part in cmd))
        return 0
    if not use_tmux:
        env = clm_env(root, project)
        os.chdir(root)
        sys.stdout.flush()
        sys.stderr.flush()
        os.execvpe(cmd[0], cmd, env)
        return 0
    start_in_tmux(root, project, cmd)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="continuum",
        description="Continuum — project runtime for Pi + CLM",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    new = sub.add_parser("new", help="create a project template in a repository")
    new.add_argument("name")
    new.add_argument("--repo", required=True)
    new.add_argument("--model", default=DEFAULT_MODEL)
    new.add_argument("--thinking", default="high")
    new.add_argument("--verifier-model", default=DEFAULT_VERIFIER)
    new.add_argument("--rollover", choices=["fork", "snapshot"], default="snapshot")
    new.add_argument("--no-link", action="store_true", help="do not create ~/.local/bin/<name>")
    new.add_argument("--no-local-extension", action="store_true", help="use the globally installed Pi package extension instead of copying it")
    new.add_argument("--local-extension", action="store_true", help="force copying the extension into this project")
    new.add_argument("--force", action="store_true")
    new.set_defaults(func=cmd_new)

    open_cmd = sub.add_parser("open", help="resume or attach to a project")
    open_cmd.add_argument("name")
    open_cmd.add_argument("--no-tmux", action="store_true")
    open_cmd.add_argument("--dry-run", action="store_true")
    open_cmd.add_argument("--no-preflight", action="store_true")
    open_cmd.set_defaults(func=cmd_open)

    seal = sub.add_parser("seal", help="snapshot the active session into its UTC day folder")
    seal.add_argument("name")
    seal.set_defaults(func=lambda a: seal_project(safe_name(a.name)))

    status = sub.add_parser("status")
    status.add_argument("name")
    status.set_defaults(func=cmd_status)

    list_cmd = sub.add_parser("list")
    list_cmd.set_defaults(func=cmd_list)

    path = sub.add_parser("path")
    path.add_argument("name")
    path.set_defaults(func=cmd_path)

    verify = sub.add_parser("verify")
    verify.add_argument("name")
    verify.add_argument("--root", help="verify a restored project root instead of the registered repo")
    verify.add_argument("--allow-empty", action="store_true", help="pass when a project has no archives yet")
    verify.set_defaults(func=cmd_verify)

    check_cmd = sub.add_parser("check", help="validate TASK.md acceptance checks against VERDICT.json")
    check_cmd.add_argument("name")
    check_cmd.set_defaults(func=cmd_check)

    backup = sub.add_parser("backup", help="run the project's configured backup command")
    backup.add_argument("name")
    backup.add_argument("--command", help="override the configured backup command")
    backup.set_defaults(func=cmd_backup)

    doctor = sub.add_parser("doctor")
    doctor.add_argument("name")
    doctor.set_defaults(func=cmd_doctor)

    fork = sub.add_parser("fork-day")
    fork.add_argument("name")
    fork.add_argument("--no-tmux", action="store_true")
    fork.add_argument("--dry-run", action="store_true")
    fork.add_argument("--no-preflight", action="store_true")
    fork.set_defaults(func=cmd_fork_day)

    run = sub.add_parser("_run", help=argparse.SUPPRESS)
    run.add_argument("root")
    run.add_argument("command", nargs=argparse.REMAINDER)
    run.set_defaults(func=cmd_internal_run)

    return parser


def main() -> int:
    invoked = Path(sys.argv[0]).name
    if invoked not in {"pi-project", "pi-project.py", "continuum"} and len(sys.argv) == 1:
        return cmd_open(argparse.Namespace(name=invoked, no_tmux=False, dry_run=False, no_preflight=False))
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
